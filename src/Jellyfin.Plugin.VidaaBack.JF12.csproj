<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.VidaaBack</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.VidaaBack</RootNamespace>
    <Version>0.1.2.1</Version>
    <OutputPath>bin/jf12/</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
    <EmbeddedResource Include="vidaa-back.js" />
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>
</Project>
